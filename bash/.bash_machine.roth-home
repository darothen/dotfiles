## MOTD
if [ -d /etc/update-motd.d/ ]; then
    if [ -e .logo ]; then cat .logo; fi 

    /etc/update-motd.d/00-header
    /etc/update-motd.d/10-help-text
    /etc/update-motd.d/50-motd-news
    /etc/update-motd.d/85-fwupd
fi

# CUDA Toolkit paths
export PATH=/usr/local/cuda/bin${PATH:+:${PATH}}
# NOTE: we don't add to our LD_LIBRARY_PATH so that we avoid conflicts with
# uv and pixi environments (we don't ever run nvcc by itself)
# export LD_LIBRARY_PATH=/usr/local/cuda/lib64${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}

# Add uv to path
source "$HOME/.local/bin/env"

# Add cargo/rust to path
. "$HOME/.cargo/env"

# Add claude to path
export PATH=~/.local/bin/claude${PATH:+:${PATH}}
